# ─────────────────────────────────────────────────────────────
# Deployment Platform – Environment Variables
# Copy to .env and fill in real values before running Docker.
# ─────────────────────────────────────────────────────────────

# ── Database (Supabase) ──────────────────────────────────────
# Use the asyncpg dialect (postgresql+asyncpg://...)
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── Auth ─────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Redis (running on the HOST machine) ──────────────────────
# The docker-compose.yml hard-codes host.docker.internal:6379/0
# Leave this here so local dev (outside Docker) still works.
REDIS_URL=redis://localhost:6379/0

# ── Cloudflare ───────────────────────────────────────────────

# ── Traefik / Domains ────────────────────────────────────────
# Root domain used by the Traefik dashboard label (traefik.<DOMAIN>)
DOMAIN=yourdomain.com

# Base domain used for deployed applications (e.g. app-<id>.yourdomain.com)
BASE_DOMAIN=yourdomain.com

# Full subdomain where the API will be reachable
API_DOMAIN=api.yourdomain.com

# Let's Encrypt registration email
ACME_EMAIL=you@yourdomain.com

# Traefik dashboard basic-auth (user:bcrypt-hashed-password)
# Generate with: echo $(htpasswd -nB admin) | sed -e s/\\$/\\$\\$/g
TRAEFIK_DASHBOARD_AUTH=admin:$$2y$$05$$...hashed...
