# ─────────────────────────────────────────────────────────────
# Deployment Platform – Environment Variables
# Copy to .env and fill in real values before running Docker.
# ─────────────────────────────────────────────────────────────

# ── Database (Supabase) ──────────────────────────────────────
# Use the asyncpg dialect (postgresql+asyncpg://...)
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── Auth ─────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Redis (running on the HOST machine) ──────────────────────
# docker-compose.yml hard-codes host.docker.internal for the container.
# Keep this for local dev (outside Docker).
REDIS_URL=redis://localhost:6379/0

# ── Cloudflare Tunnel ────────────────────────────────────────
# Get this from: Cloudflare Zero Trust → Access → Tunnels → your tunnel → Configure
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here

# ── Traefik / Domains ────────────────────────────────────────
# Full subdomain where the API will be reachable
API_DOMAIN=api.thechinmay.in
